begin;
    create table account(
        id int primary key,
        category text
    );
    insert into public.account(id, category)
    values
        (1, 'a'),
        (2, 'b'),
        (3, 'c');
    create function list_accounts()
        returns setof account
        stable
        language sql
    as $$
        select * from account;
    $$;
    -- Table collection ignores the filter when the variable is omitted
    select jsonb_pretty(
        graphql.resolve($$
            query Accounts($category: String) {
              accountCollection(filter: {category: {eq: $category}}) {
                edges {
                  node {
                    id
                    category
                  }
                }
              }
            }
        $$,
        variables := '{}'
        )
    );
              jsonb_pretty               
-----------------------------------------
 {                                      +
     "data": {                          +
         "accountCollection": {         +
             "edges": [                 +
                 {                      +
                     "node": {          +
                         "id": 1,       +
                         "category": "a"+
                     }                  +
                 },                     +
                 {                      +
                     "node": {          +
                         "id": 2,       +
                         "category": "b"+
                     }                  +
                 },                     +
                 {                      +
                     "node": {          +
                         "id": 3,       +
                         "category": "c"+
                     }                  +
                 }                      +
             ]                          +
         }                              +
     }                                  +
 }
(1 row)

    -- Function collection should do the same
    select jsonb_pretty(
        graphql.resolve($$
            query Accounts($category: String) {
              listAccounts(filter: {category: {eq: $category}}) {
                edges {
                  node {
                    id
                    category
                  }
                }
              }
            }
        $$,
        variables := '{}'
        )
    );
              jsonb_pretty               
-----------------------------------------
 {                                      +
     "data": {                          +
         "listAccounts": {              +
             "edges": [                 +
                 {                      +
                     "node": {          +
                         "id": 1,       +
                         "category": "a"+
                     }                  +
                 },                     +
                 {                      +
                     "node": {          +
                         "id": 2,       +
                         "category": "b"+
                     }                  +
                 },                     +
                 {                      +
                     "node": {          +
                         "id": 3,       +
                         "category": "c"+
                     }                  +
                 }                      +
             ]                          +
         }                              +
     }                                  +
 }
(1 row)

    -- Function collection applies the filter when the variable is set
    select jsonb_pretty(
        graphql.resolve($$
            query Accounts($category: String) {
              listAccounts(filter: {category: {eq: $category}}) {
                edges {
                  node {
                    id
                    category
                  }
                }
              }
            }
        $$,
        variables := '{"category": "b"}'
        )
    );
              jsonb_pretty               
-----------------------------------------
 {                                      +
     "data": {                          +
         "listAccounts": {              +
             "edges": [                 +
                 {                      +
                     "node": {          +
                         "id": 2,       +
                         "category": "b"+
                     }                  +
                 }                      +
             ]                          +
         }                              +
     }                                  +
 }
(1 row)

rollback;
